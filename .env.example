# Supabase — pegue essas chaves no painel do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # usar SOMENTE no backend (nunca expor no client)

# WhatsApp da Bia, formato internacional só com dígitos (ex: 5562981173714)
WHATSAPP_NUMBER=

# URL pública do site em produção (sem barra no final) — usada pra montar o
# link do pedido embutido na mensagem do WhatsApp. Em dev, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Opcional — remoção/padronização de fundo das fotos de peça via Poof.
# Sem essa chave, o pipeline simplesmente pula essa etapa e usa a foto original.
POOF_API_KEY=
